// Publicação do app na Cloudflare (Workers com arquivos estáticos, plano gratuito).
// Build: npm install && npm run build -w app   ·   Deploy: npx wrangler deploy
{
  "name": "crad",
  "compatibility_date": "2026-09-01",
  // endereço gratuito crad.<conta>.workers.dev; sem cópias de prévia por branch
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./app/dist",
    // Telas como /catalogo ou /transparencia abrem direto pelo endereço.
    "not_found_handling": "single-page-application"
  }
}
